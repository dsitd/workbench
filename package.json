{
  "name": "local-code-workbench",
  "version": "0.5.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "A personal desktop coding workspace with an independent agent runtime",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts src/renderer/tests/*.test.ts",
    "eval": "tsx scripts/eval.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "electron .",
    "package": "npm run build && electron-builder --mac dir --publish never",
    "dist": "npm run build && electron-builder --mac dmg zip --publish never",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "lifecycle:check": "npm run build && node scripts/lifecycle-smoke.mjs",
    "sandbox:check": "tsx scripts/sandbox-smoke.ts",
    "features:check": "npm run build && node scripts/features-smoke.mjs",
    "chats:check": "npm run build && node scripts/chat-management-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@vscode/ripgrep": "1.18.0",
    "ajv": "^8.20.0",
    "cheerio": "^1.1.2",
    "diff": "^8.0.2",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.10",
    "playwright": "^1.55.1",
    "tsx": "^4.20.6",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "dev.localcode.workbench",
    "productName": "Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "title": "Workbench"
    },
    "asarUnpack": [
      "node_modules/@vscode/ripgrep*/**"
    ]
  }
}
